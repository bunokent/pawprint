# Run the whole stack in Docker with one command:
#   cp .env.example .env   # then fill in the secrets below
#   docker compose up --build
# Frontend: http://localhost:5173  ·  API: http://localhost:8000  ·  Mailpit UI: :8025
# (compose's web/celery/frontend services read this file via env_file; the in-network
# postgres/redis/mailpit hosts are pinned by compose itself.)

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# PostgreSQL 16 — docker-compose service `postgres`, published on host port 5433.
# Host-side `python manage.py ...` auto-loads this file (python-dotenv), so these
# host-published values work for local runs; the web/celery containers pin the
# in-network values (postgres:5432) themselves via `environment:` in compose.
POSTGRES_DB=pawprint
POSTGRES_USER=pawprint
POSTGRES_PASSWORD=pawprint
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Redis 7 (docker-compose service `redis`, published on host port 6379 — host-usable
# default; the web/celery containers pin the in-network redis:6379 via `environment:`)
REDIS_URL=redis://127.0.0.1:6379/0

# Storage — Cloudinary (private delivery, signed URLs). From the Cloudinary console:
#   Dashboard -> "Go to API Keys" -> copy the environment variable.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Or set the discrete vars instead:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Frontend
FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Auth — Google/Gmail OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Payments (TEST MODE)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PAYMONGO_SECRET_KEY=sk_test_...
PAYMONGO_WEBHOOK_SECRET=whsec_...
PAYMONGO_BASE_URL=https://api.paymongo.com

# AI vision gatekeeper
YOLO_MODEL_PATH=yolov8s-worldv2.pt
YOLO_CONFIDENCE_THRESHOLD=0.20

# Email (mailpit in dev, published on host port 1025; containers pin mailpit:1025)
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
