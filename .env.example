# PawPrint runs containerized: `docker compose up` starts PostgreSQL + Redis (internal
# only — the host ports 5433/6379/1025 belong to the host services below), the Django API
# (web), the Celery worker, and the Vite dev server (frontend) —
#   API       http://localhost:8000
#   Frontend  http://localhost:5173   (Vite proxies /api, /media, /ws to the web service)
#   Email     goes to the HOST mailpit (host.docker.internal:1025, UI http://localhost:8025)
#             — self-contained alternative: COMPOSE_EMAIL_HOST=mailpit docker compose --profile mailpit up
# Compose injects this .env and overrides POSTGRES_HOST/REDIS_URL/EMAIL_HOST/YOLO_MODEL_PATH
# to in-network values. Vision weights are baked into the backend image at build time by
# backend/scripts/download_weights.sh into /opt/weights (direct download, sha256-pinned,
# no Hugging Face token).
#
# Host-only fallback (no Docker) — one-time setup (Arch/Omarchy; use your distro's
# equivalents):
#   sudo pacman -S postgresql mailpit valkey   # valkey ships redis-server/redis-cli
#   initdb -D ~/pg5433 -U postgres --auth=trust # dedicated cluster on :5433, so tests
#   pg_ctl -D ~/pg5433 -l ~/pg5433.log -o "-p 5433 -k $HOME/pg5433 -c listen_addresses=127.0.0.1" start
#   createdb -h 127.0.0.1 -p 5433 -U postgres pawprint
#   redis-server --port 6379 --bind 127.0.0.1 --daemonize yes
#   mailpit &                                   # dev SMTP :1025, web UI :8025
#   sh backend/scripts/download_weights.sh     # fetch YOLO-World + CLIP weights directly
#
# Then run the app:
#   cp .env.example .env                        # fill in the secrets below
#   cd backend && .venv/bin/python manage.py migrate
#   cd backend && .venv/bin/python manage.py runserver 8000        # API on :8000
#   cd backend && .venv/bin/celery -A config worker -Q flyers,webhooks,images,default -l info
#   cd frontend && npm run dev                                      # http://localhost:5173
# Vite proxies /api, /media and /ws to PAWPRINT_API_URL (default http://127.0.0.1:8000).

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# PostgreSQL — local cluster on 127.0.0.1:5433 (see header). Host-side
# `python manage.py ...` auto-loads this file via python-dotenv; real environment
# variables always win over it.
POSTGRES_DB=pawprint
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Redis (valkey ships redis-server) — local server on 127.0.0.1:6379
REDIS_URL=redis://127.0.0.1:6379/0

# Storage — Cloudinary (private delivery, signed URLs). From the Cloudinary console:
#   Dashboard -> "Go to API Keys" -> copy the environment variable.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Or set the discrete vars instead:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Frontend
FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Auth — Google/Gmail OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Payments (TEST MODE)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PAYMONGO_SECRET_KEY=sk_test_...
PAYMONGO_WEBHOOK_SECRET=whsec_...
PAYMONGO_BASE_URL=https://api.paymongo.com

# AI vision gatekeeper. Weights are downloaded DIRECTLY (no Hugging Face token):
#   sh backend/scripts/download_weights.sh
# yolov8s-worldv2.pt  <- github.com/ultralytics/assets release asset
# weights/clip/ViT-B-32.pt <- OpenAI public blob (sha256-pinned)
YOLO_MODEL_PATH=yolov8s-worldv2.pt
YOLO_CONFIDENCE_THRESHOLD=0.20
# Hard guarantee that nothing fetches from Hugging Face (no token needed/used)
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Email — local mailpit on 127.0.0.1:1025 (web UI on :8025)
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
